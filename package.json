{
  "name": "conductor-ai-workspace",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "start:container": "wrangler dev --config wrangler.container.jsonc --ip 0.0.0.0 --port 3000 --persist-to /data",
    "test": "npm run build && node --experimental-strip-types --test tests/*.test.mjs tests/*.test.ts && tsx --test companion/*.test.ts",
    "test:e2e": "playwright test tests/portal-live.spec.ts --workers=1",
    "benchmark:agents": "node tests/sdk-benchmark.mjs",
    "test:harness-contract": "node --test tests/harness-contract.test.mjs",
    "orchestrator": "node orchestrator/cli.mjs",
    "orchestrator:validate": "node orchestrator/cli.mjs validate",
    "orchestrator:status": "node orchestrator/cli.mjs status",
    "handoff:token": "node --experimental-strip-types orchestrator/handoff-token.ts",
    "test:handoff-live": "node --experimental-strip-types tests/handoff-live-smoke.ts",
    "test:automation-live": "node --experimental-strip-types tests/automation-live-smoke.ts",
    "test:orchestrator": "node --test tests/orchestrator.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern work",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "operations:replay": "node scripts/operations-recovery.mjs replay artifacts/operations-clean.sqlite",
    "operations:drill": "node scripts/operations-recovery.mjs drill artifacts/operations-clean.sqlite artifacts/operations-clean.sqlite.backup",
    "release:gate": "node scripts/release-gate.mjs",
    "companion:git": "tsx companion/local-git-server.ts",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "mcp:config": "docker compose -f compose.yaml -f compose.mcp.yaml config",
    "mcp:up": "docker compose -f compose.yaml -f compose.mcp.yaml up -d --build",
    "mcp:down": "docker compose -f compose.yaml -f compose.mcp.yaml down"
  },
  "dependencies": {
    "@openai/agents": "^0.13.3",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.24.0",
    "next": "^16.2.10",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.45.1",
    "@cloudflare/workers-types": "^5.20260719.1",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "^8.1.5",
    "wrangler": "^4.112.0"
  },
  "optionalDependencies": {
    "@rolldown/binding-win32-x64-msvc": "^1.0.1"
  },
  "overrides": {
    "ws": "8.21.1"
  },
  "type": "module"
}
