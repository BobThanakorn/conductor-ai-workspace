# Preferred live provider. Keep this key server-only; never expose it in browser code or commit it.
AZURE_AI_FOUNDRY_ENDPOINT=https://ai-environment-resource.services.ai.azure.com
AZURE_AI_FOUNDRY_API_KEY=
AZURE_AI_FOUNDRY_MODEL=gpt-5.1-codex-mini
# Optional comma-separated allowlist shown in the UI model picker.
CONDUCTOR_MODEL_OPTIONS=gpt-5.1-codex-mini,gpt-5.4-mini

# Optional OpenAI-compatible vLLM model. Selecting VLLM_MODEL routes only that model to this endpoint.
VLLM_BASE_URL=http://host.docker.internal:9020/v1
VLLM_API_KEY=EMPTY
VLLM_MODEL=Qwen/Qwen3.6-35B-A3B

# Optional legacy OpenAI fallback. When Azure is configured, Azure takes precedence.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_AGENT_MODEL=
OPENAI_MODEL=gpt-5.6-terra

# Docker Compose. WORKSPACE_PATH is the repository the agent may change.
CONDUCTOR_IMAGE=conductor-ai-workspace:local
CONDUCTOR_WEB_PORT=3000
CONDUCTOR_COMPANION_PORT=8765
# Comma-separated browser origins allowed to call the localhost companion.
CONDUCTOR_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
WORKSPACE_PATH=.

# Optional remote Git/API credentials. Keep these in an ignored .env file.
GITHUB_TOKEN=
GITLAB_TOKEN=
GIT_HTTP_USERNAME=x-access-token

# Optional Docker Compose override inputs.
AZURE_AI_FOUNDRY_API_KEY_FILE=./secret.azure-api-key
OPENAI_API_KEY_FILE=./secret.openai-api-key
GITHUB_TOKEN_FILE=./secret.github-token
MCP_SECRET_FILE=./.mcp.env
DOCKER_CODING_MODEL=ai/qwen2.5-coder:7B-Q4_K_M
