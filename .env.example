# Preferred live provider. Keep Azure key server-only; never commit it.
AZURE_AI_FOUNDRY_ENDPOINT=https://ai-environment-resource.services.ai.azure.com
AZURE_AI_FOUNDRY_API_KEY=
AZURE_AI_FOUNDRY_MODEL=gpt-5.1-codex-mini
# Optional: set to opensource to prefer the open-source endpoint below over Azure.
# CONDUCTOR_PRIMARY_LLM=opensource
# Comma-separated allowlist shown in the UI model picker.
CONDUCTOR_MODEL_OPTIONS=gpt-5.1-codex-mini,qwen3.6
# Required for agent-to-agent handoffs. Generate a long random value and keep it server-side.
CONDUCTOR_HANDOFF_SIGNING_SECRET=
CONDUCTOR_AGENT_QUOTA_PER_MINUTE=60
CONDUCTOR_AUTOMATION_QUOTA_PER_MINUTE=30

# OpenAI-compatible open-source endpoint. Variable names say VLLM_* for history,
# but the same settings work for local vLLM, Docker Model Runner, or LiteLLM proxy.
# Pick ONE block below and comment out the other.

# Local vLLM on the host (from inside Docker use host.docker.internal):
# VLLM_BASE_URL=http://host.docker.internal:9020/v1
# VLLM_API_KEY=EMPTY
# VLLM_MODEL=Qwen/Qwen3.6-35B-A3B

# Remote LiteLLM proxy (virtual key usually starts with sk-; base URL must include /v1):
VLLM_BASE_URL=https://your-litellm-host.example/v1
VLLM_API_KEY=sk-your-litellm-virtual-key
VLLM_MODEL=qwen3.6

# Optional legacy OpenAI fallback. When Azure is configured, Azure takes precedence.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_AGENT_MODEL=
OPENAI_MODEL=gpt-5.6-terra

# Docker Compose. WORKSPACE_PATH is the repository the agent may change.
CONDUCTOR_IMAGE=conductor-ai-workspace:local
CONDUCTOR_WEB_PORT=3000
CONDUCTOR_COMPANION_PORT=8765
CONDUCTOR_LANGGRAPH_COMPANION_PORT=8766
CONDUCTOR_LANGGRAPH_IMAGE=conductor-langgraph-agent:local
# Optional defense in depth for communication from the web service to the
# internal LangGraph service. Use a long random value outside local development.
LANGGRAPH_INTERNAL_TOKEN=
# Optional Docker MCP Gateway. Enable with compose.mcp.yaml after configuring
# MCP_SECRET_FILE and the Docker Desktop MCP gateway.
MCP_GATEWAY_URL=
# Required for MCP registry lifecycle mutations. Send it only through the
# X-Conductor-MCP-Admin request header; never expose it in browser bundles.
MCP_ADMIN_TOKEN=
# Optional credential for authenticating Conductor to the gateway itself.
MCP_GATEWAY_AUTH_TOKEN=
# Optional server-side JSON allowlist. The API accepts only an allowlist ID and
# never accepts a URL or credential. Omit to allow the configured Docker gateway.
# MCP_SERVER_ALLOWLIST=[{"id":"docker-mcp-gateway","label":"Docker MCP Gateway","url":"http://mcp-gateway:8811"}]
# Comma-separated browser origins allowed to call the localhost companion.
CONDUCTOR_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://conductor-workspace-20260715.galilrevanov.chatgpt.site
WORKSPACE_PATH=.

# GitHub App integration. These values are server-only and must never be sent
# to the browser, companion, audit log, or repository. The private key must be
# PKCS#8 PEM with literal newlines or escaped \n characters.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# Short-lived, payload-bound protected-publication permits are signed with this
# value after fresh GitHub branch/check/review verification.
CONDUCTOR_PUBLICATION_SIGNING_SECRET=

# Automation ownership defaults to a short-lived signed human identity. Enable
# platform identity headers only behind a trusted hosting proxy that strips
# caller-supplied copies. Scheduler and webhook secrets are server-only HMAC
# keys; use independent random values and never expose them to the browser.
CONDUCTOR_TRUST_PLATFORM_IDENTITY=false
CONDUCTOR_AUTOMATION_SCHEDULER_SECRET=
CONDUCTOR_AUTOMATION_WEBHOOK_SECRET=

# Optional Docker Compose override inputs.
AZURE_AI_FOUNDRY_API_KEY_FILE=./secret.azure-api-key
OPENAI_API_KEY_FILE=./secret.openai-api-key
MCP_SECRET_FILE=./.mcp.env
DOCKER_CODING_MODEL=ai/qwen2.5-coder:7B-Q4_K_M
