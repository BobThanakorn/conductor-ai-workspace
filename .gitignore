# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
.mcp.env
secret.*
!secret.*.example

# local credentials and generated deployment bundles
*.tar.gz
*.tsbuildinfo
docker-compose.override.yml
docker-compose.override.yaml

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/outputs/
/work/
/workspace/
/artifacts/
__pycache__/
*.py[cod]

# local roadmap orchestrator runtime (template and roadmap remain tracked)
/orchestrator/state.json
/orchestrator/state.json.lock

# per-task isolated worktrees and lifecycle evidence
/.conductor/
